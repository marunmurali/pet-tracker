# Copy to .env and fill in. Never commit .env.

# --- Camera (Tapo app > camera > Settings > Advanced Settings > Camera Account) ---
CAM_HOST=192.168.1.50          # give the camera a DHCP reservation on your router
CAM_USER=
CAM_PASS=
CAM_STREAM=stream2             # stream2 = 640x360 (lighter, good for Pi); stream1 = full HD
ONVIF_PORT=2020                # Tapo's ONVIF port, used for pan/tilt
TAPO_CLOUD_PASSWORD=           # optional: your TP-Link account password, only for the pytapo pan/tilt fallback
PTZ_BACKEND=onvif              # onvif | pytapo | none
PTZ_HOME_PRESET=               # optional: preset token/id to return to when the dog is lost (zones need this)
PTZ_INVERT_PAN=false           # set true if the camera turns away from the dog horizontally
PTZ_INVERT_TILT=false          # ...or vertically

# --- Telegram (create a bot with @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=              # only this chat may control the bot

# --- Behaviour ---
DOG_NAME=Buddy
TZ=Asia/Dubai
YOLO_IMGSZ=320                 # 640 if the dog looks small in the frame (~4x CPU). To change: rm models/yolo11n.onnx, re-run setup_models.sh
YOLO_MODEL=yolo11n.onnx        # file in models/; yolo11n-mydog.onnx after scripts/train_dog.sh
DOG_CONF_THRESHOLD=0.45
BARK_THRESHOLD=0.5             # YAMNet score for "Bark"/"Dog"/"Bow-wow"
BARK_ALERT_COOLDOWN_S=120      # at most one Telegram alert per this window
CLIP_PRE_S=5
CLIP_POST_S=10
DAILY_SUMMARY_TIME=21:00
TRACKING_ENABLED=true          # pan/tilt to follow the dog
LOST_TIMEOUT_S=8               # dog not seen this long -> stop following and start the sweep
SWEEP_ON_LOST=true             # when lost, pan back and forth between the end stops to find him
SWEEP_MAX_S=120                # give up after this long (then go to PTZ_HOME_PRESET, if set)
SWEEP_MIN_GAP_S=300            # at least this long between sweeps, to spare the motor
ZONES=                         # optional, home position only: bed:0.05,0.55,0.4,0.95;bowl:0.7,0.7,0.9,0.95
SNAPSHOT_INTERVAL_MIN=30       # snapshot while the dog is visible, used in the daily summary
TRAINING_CAPTURE=true          # keep labelled pictures of him in data/snapshots/training/ (for retraining later)
TRAINING_INTERVAL_S=10         # at most one training picture per this many seconds

# --- Advanced (defaults suit a Pi 5) ---
STREAM_FPS=10                  # frames decoded per second (also the clip frame rate)
DETECT_FPS=6                   # YOLO runs per second
FRAME_WIDTH=640
FRAME_HEIGHT=360
CAM_SOURCE=                    # testing: a file in data/samples/ to use instead of the camera

# --- Dashboard ---
DASHBOARD_PORT=8000
DASHBOARD_TOKEN=               # set a long random string; required to view or toggle
